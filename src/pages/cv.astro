---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";
---

<BaseLayout title="Resume" sideBarActiveItemID="cv">
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Profile</div>
  </div>

  <div class="mb-10 text-justify">
    A recent Robotics Master’s graduate from University of Pennsylvania with a strong background in automation, robotics, 
    and mechatronics who is committed to driving innovation and contributing to meaningful, real-world solutions in 
    automation and AI.
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Education</div>
  </div>

  <div class="time-line-container grid gap-4 mb-10">
    <TimeLineElement
      title="University of Pennsylvania"
      subtitle="Master of Science in Engineering in Robotics, 2023-2025"
    />
    <TimeLineElement
      title="University of California, San Diego"
      subtitle="Bachelor of Science in Mechanical Engineering, 2014-2019"
    />
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Experience</div>
  </div>

  <div class="time-line-container mb-10">
    <TimeLineElement
      title="GRASP Lab"
      subtitle="Master's Thesis - Construction Robot from Sept 2024 to May 2025, Philadelphia, PA"
    >
      <ul class="list-disc pl-6">
        <li>Program a mobile robot that autonomously delivers blown insulation.</li>
        <li>Use RGBD and LiDAR sensors to model and monitor insulation deposition.</li>
        <li>Develop image and point cloud algorithms for accurate robot perception.</li>
        <li>Devise state estimation and control feedback algorithms for precise insulation delivery.</li>
        <li>Integrate hardware and validate performance through real-world testing.</li>
      </ul>
    <br />

    </TimeLineElement>
    <TimeLineElement
      title="Tesla"
      subtitle="Manufacturing Engineering Intern from May 2024 to Aug 2024, Austin, TX"
    >
      <ul class="list-disc pl-6">
        <li>Use machine learning techniques to determine optimal process parameters.</li>
        <li>Program KUKA industrial robot arms.</li>
        <li>Perform statistical analysis on automated equipment scrap data.</li>
        <li>Implement machine vision inspection using Keyence laser profiler.</li>
        <li>Test various media in robotic edge rounding process to reduce media usage.</li>
      </ul>
    <br />

    </TimeLineElement>
    <TimeLineElement
      title="Applied Medical"
      subtitle="Process Engineer II from June 2019 to Nov 2022, Rancho Santa Margarita, CA"
    >
      <ul class="list-disc pl-6">
        <li>Design a semi-automated spot welding equipment (50,000 parts/month).</li>
        <li>Determine optimal process parameters for automated gluing robot.</li>
        <li>Develop new grinding process that reduces cycle time by 40%.</li>
        <li>Save $3M/year by addressing a surgical blade manufacturing root cause.</li>
        <li>Implement medical device inspection, testing, and assembly processes.</li>
      </ul>
    <br />

    </TimeLineElement>
    <TimeLineElement
      title="Boechler Lab"
      subtitle="Undergraduate Researcher from June 2018 to June 2019, San Diego, CA"
    >
      <ul class="list-disc pl-6">
        <li>Construct pneumatic and spring-actuated impact machines.</li>
        <li>Design remote-triggering mechatronic mechanism.</li>
      </ul>
    <br />
    </TimeLineElement>
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Skills</div>
  </div>

  <ul class="list-disc md:columns-5 columns-2 mx-6">
    <li>PLC</li>
    <li>HMI/SCADA</li>
    <li>SQL</li>
    <li>Solidworks</li>
    <li>AutoCAD</li>
    <li>Machine Learning</li>
    <li>Python & Pytorch</li>
    <li>C/C++</li>
    <li>Robot Operating System</li>
    <li>Mechatronics</li>
    <li>Arduino & Raspberry Pi</li>
    <li>MATLAB</li>
    <li>VHDL</li>
    <li>x86 Assembly</li>
    <li>Rapid Prototyping</li>
    <li>Finite Element Analysis</li>
  </ul>
</BaseLayout>
